<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AroundTheWorldClocks.Controls">
    <!-- Mica Glass: dark translucent panel, white dials by day, graphite by night. -->

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#A61C202C" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="6,10" />
    </Style>

    <DataTemplate x:Key="ClockItemTemplate">
        <StackPanel Orientation="{Binding ItemOrientation}" Margin="8,2">
            <controls:ClockFace Width="{Binding ClockSize}" Height="{Binding ClockSize}" HorizontalAlignment="Center" />
            <StackPanel Margin="{Binding LabelMargin}" HorizontalAlignment="{Binding LabelAlignment}" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextAlignment="{Binding LabelTextAlignment}"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                <TextBlock TextAlignment="{Binding LabelTextAlignment}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Foreground="#B3FFFFFF"><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="{Binding DayOffsetText, Mode=OneWay}" Foreground="#7FD3FF" /></TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
