<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AroundTheWorldClocks.Controls">
    <!-- Inset Digital: the digital time is printed inside the dial, so the label only carries the city. -->

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#1F2023" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="6,12" />
    </Style>

    <DataTemplate x:Key="ClockItemTemplate">
        <StackPanel Orientation="{Binding ItemOrientation}" Margin="8,2">
            <controls:ClockFace Width="{Binding ClockSize}" Height="{Binding ClockSize}" HorizontalAlignment="Center" />
            <TextBlock Margin="{Binding LabelMargin}" HorizontalAlignment="{Binding LabelAlignment}" VerticalAlignment="Center"
                       TextAlignment="{Binding LabelTextAlignment}" FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F2"><Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text="{Binding DayOffsetText, Mode=OneWay}" FontWeight="Normal" Foreground="#FF8A5C" /></TextBlock>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
