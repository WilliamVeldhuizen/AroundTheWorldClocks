<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AroundTheWorldClocks.Controls">
    <!-- Roman Classic: ivory panel with a gold rule, Roman numerals, blued moon hands, Georgia italic labels. -->

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#F6F1E4" />
        <Setter Property="BorderBrush" Value="#C9AE74" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,12" />
        <!-- Room for the drop shadow inside the window bounds. -->
        <Setter Property="Margin" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ClockItemTemplate">
        <StackPanel Orientation="{Binding ItemOrientation}" Margin="8,2">
            <controls:ClockFace Width="{Binding ClockSize}" Height="{Binding ClockSize}" HorizontalAlignment="Center" />
            <StackPanel Margin="{Binding LabelMargin}" HorizontalAlignment="{Binding LabelAlignment}" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextAlignment="{Binding LabelTextAlignment}"
                           FontFamily="Georgia" FontStyle="Italic" FontSize="12.5" Foreground="#1D1D1D" />
                <TextBlock TextAlignment="{Binding LabelTextAlignment}" FontFamily="Georgia" FontSize="11" Foreground="#6E6450"><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="{Binding DayOffsetText, Mode=OneWay}" Foreground="#1C3F94" /></TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
