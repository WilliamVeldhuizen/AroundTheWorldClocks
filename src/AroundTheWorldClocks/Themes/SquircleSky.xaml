<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AroundTheWorldClocks.Controls">
    <!-- Squircle Sky: app-icon squares filled with each city's sky, floating on the desktop. -->

    <Style x:Key="PanelStyle" TargetType="Border">
        <!-- Almost transparent: fully transparent pixels would not receive the mouse for dragging. -->
        <Setter Property="Background" Value="#01000000" />
        <Setter Property="Padding" Value="8,6,8,12" />
    </Style>

    <DataTemplate x:Key="ClockItemTemplate">
        <StackPanel Orientation="{Binding ItemOrientation}" Margin="8,4">
            <controls:ClockFace Width="{Binding ClockSize}" Height="{Binding ClockSize}" HorizontalAlignment="Center">
                <controls:ClockFace.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="270" Opacity="0.3" />
                </controls:ClockFace.Effect>
            </controls:ClockFace>
            <StackPanel Margin="{Binding LabelMargin}" HorizontalAlignment="{Binding LabelAlignment}" VerticalAlignment="Center">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.85" />
                </StackPanel.Effect>
                <TextBlock Text="{Binding DisplayName}" TextAlignment="{Binding LabelTextAlignment}"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                <TextBlock TextAlignment="{Binding LabelTextAlignment}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Foreground="#D9FFFFFF"><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="{Binding DayOffsetText, Mode=OneWay}" Foreground="#FFD166" /></TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
