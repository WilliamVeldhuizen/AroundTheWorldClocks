<Window x:Class="AroundTheWorldClocks.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AroundTheWorldClocks.Controls"
        Title="Around The World Clocks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Border Background="{StaticResource WidgetBackground}" CornerRadius="10" Padding="6">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="_Settings..." Click="OnSettingsClick" />
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on _top" IsCheckable="True" Click="OnAlwaysOnTopClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Clocks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <!-- Horizontal layout: labels under the clock. Vertical layout: labels to the right of the clock. -->
                <DataTemplate>
                    <StackPanel Margin="6,4"
                                MinWidth="{Binding DataContext.ClockSize, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Vertical" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                                        <Setter Property="Orientation" Value="Horizontal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <controls:AnalogClock HorizontalAlignment="Center"
                                              Width="{Binding DataContext.ClockSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Height="{Binding DataContext.ClockSize, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="TextBlock.TextAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                                            <Setter Property="Margin" Value="10,0,4,0" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource WidgetForeground}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource WidgetSubtleForeground}">
                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                <Run Text="{Binding DayOffsetText, Mode=OneWay}" FontSize="10"
                                     Foreground="{StaticResource WidgetAccent}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
