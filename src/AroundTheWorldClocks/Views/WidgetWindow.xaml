<Window x:Class="AroundTheWorldClocks.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Around The World Clocks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <!-- PanelStyle and ClockItemTemplate come from the active Themes/*.xaml dictionary (see ApplyTheme). -->
    <Border Style="{DynamicResource PanelStyle}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="_Settings..." Click="OnSettingsClick" />
                <MenuItem x:Name="ThemeMenuItem" Header="T_heme" />
                <MenuItem x:Name="SecondHandMenuItem" Header="Show s_econd hand" IsCheckable="True" Click="OnSecondHandClick" />
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on _top" IsCheckable="True" Click="OnAlwaysOnTopClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Clocks}" ItemTemplate="{DynamicResource ClockItemTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</Window>
