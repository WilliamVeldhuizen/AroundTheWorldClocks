<UserControl x:Class="AroundTheWorldClocks.Controls.AnalogClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="64" d:DesignHeight="64">
    <!-- DataContext is a ClockViewModel. Foreground drives the ticks and hands; it flips with day/night. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="#FF202020" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNight}" Value="True">
                    <Setter Property="Foreground" Value="#FFF0F0F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <!-- Everything is drawn on a 100x100 canvas and scaled to the control size. -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Dial" Width="100" Height="100">
            <Ellipse Width="96" Height="96" Canvas.Left="2" Canvas.Top="2" StrokeThickness="2">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#FFF7F7F7" />
                        <Setter Property="Stroke" Value="#FFBDBDBD" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNight}" Value="True">
                                <Setter Property="Fill" Value="#FF2E3440" />
                                <Setter Property="Stroke" Value="#FF4C566A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- Hour ticks are added in code-behind. -->

            <Line X1="50" Y1="50" X2="50" Y2="26" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Line.RenderTransform>
                    <RotateTransform CenterX="50" CenterY="50" Angle="{Binding HourAngle}" />
                </Line.RenderTransform>
            </Line>

            <Line X1="50" Y1="50" X2="50" Y2="14" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Line.RenderTransform>
                    <RotateTransform CenterX="50" CenterY="50" Angle="{Binding MinuteAngle}" />
                </Line.RenderTransform>
            </Line>

            <Line X1="50" Y1="58" X2="50" Y2="10" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{StaticResource WidgetAccent}">
                <Line.Style>
                    <Style TargetType="Line">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSecondHand}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Line.Style>
                <Line.RenderTransform>
                    <RotateTransform CenterX="50" CenterY="50" Angle="{Binding SecondAngle}" />
                </Line.RenderTransform>
            </Line>

            <Ellipse Width="6" Height="6" Canvas.Left="47" Canvas.Top="47" Fill="{StaticResource WidgetAccent}" />
        </Canvas>
    </Viewbox>
</UserControl>
